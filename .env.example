# ==============================================================================
# INTELLIGENT TRADING AGENT - CONCENTRATED LIQUIDITY LP (BASE L2)
# ==============================================================================

# Rete Base (Chain ID 8453)
BASE_RPC_URL=https://mainnet.base.org
WALLET_ADDRESS=
PRIVATE_KEY=

# Modalita' operativa
DRY_RUN=true
PAPER_TRADING=true
PAPER_START_USDC=1000.0
PAPER_START_ETH=0.5
PAPER_GAS_USD=0.03

# Configurazione del Pool Uniswap V3
POOL_TOKEN0=WETH
POOL_TOKEN1=USDC
POOL_FEE=500  # 0.05% (500 bps)

# Parametri di Range e Re-centering
RANGE_WIDTH_PCT=8.0                 # Ampiezza del range (+/- 4.0% attorno al prezzo)
OUT_OF_RANGE_BUFFER_PCT=0.5         # Buffer di tolleranza prima del bordo (%)
MIN_HOLD_HOURS_BEFORE_RECENTER=2.0  # Tempo minimo di permanenza prima di poter riposizionare (anti-whipsaw)

# Riscossione e Capitalizzazione Commissioni
AUTO_COLLECT_FEES=true
MIN_FEE_COLLECT_USD=5.0
COMPOUND_FEES=true

# Parametri di Esecuzione & Slippage Uniswap V3
DEFAULT_SLIPPAGE_BPS=50
MAX_SLIPPAGE_BPS=100
MAX_GAS_PRICE_GWEI=0.5
MIN_ETH_RESERVE=0.002

# Auto-refuel USDC da riserve native ETH
AUTO_SWAP_ETH_TO_USDC=true
ETH_GAS_RESERVE=0.003
MIN_ETH_SWAP_AMOUNT=0.002
USDC_AUTO_SWAP_THRESHOLD=5.0

# AI Reasoning (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_FALLBACK_RULES=true

# Notifiche e Comandi Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard Web
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8081
DASHBOARD_ADMIN_TOKEN=

# Ciclo di loop (secondi fra controlli orari/regolari)
LOOP_SLEEP_SECONDS=900

# Timeout HTTP RPC e transazioni
HTTP_TIMEOUT=30
TX_TIMEOUT_SECONDS=300
TX_DEADLINE_SECONDS=600
